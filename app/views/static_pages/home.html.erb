<div class="hero panel">
  <h1>Welcome to drosophila.me</h1>
  <p>Drosophila cross and stock management made easy</p>
  <% unless authenticated? %>
    <p><%= link_to "Register", new_registration_path, class: "button" %></p>
  <% end %>
</div>
<%= image_tag "drosophila.jpeg", class: "hero-photo", alt: "A Drosophila melanogaster fruit fly" %>
<div class="panel counts">
  <div><span class="count"><%= @user_count %></span> registered users</div>
  <div><span class="count"><%= @cross_count %></span> flies crossed</div>
  <div><span class="count"><%= @stock_count %></span> stocks established</div>
</div>
<p><%= link_to "Team and contact", team_path %></p>
