<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "drosophila.me" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="drosophila.me">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/favicon.ico">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script>
      window.MathJax = { loader: { load: ["ui/safe"] } };
      document.addEventListener("turbo:load", function () {
        if (window.MathJax && MathJax.typesetPromise) { MathJax.typesetPromise(); }
      });
    </script>
    <script async src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-mml-chtml.js"></script>
  </head>
  <body>
    <header class="site-header">
      <%= link_to "drosophila.me", root_path, class: "brand" %>
      <nav>
        <%= link_to "Your crosses", crosses_path %>
        <%= link_to "Your stocks", stocks_path %>
        <% if authenticated? %>
          <%= link_to "Edit profile", edit_account_path %>
          <%= button_to "Logout", session_path, method: :delete, class: "link-button" %>
        <% else %>
          <%= link_to "New user", new_registration_path %>
          <%= link_to "Login", new_session_path %>
        <% end %>
      </nav>
    </header>
    <main class="page">
      <% flash.each do |kind, message| %>
        <p class="flash flash-<%= kind %>" role="status"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
