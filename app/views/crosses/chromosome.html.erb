<% content_for(:title) { "Chromosomes · drosophila.me" } %>
<% owner = @cross.owned_by?(Current.user) %>
<%= render "header", cross: @cross %>
<%= render "parents", cross: @cross %>
<%= render "tabs", cross: @cross, current: :chromosome %>
<%= form_with url: crosses_path, scope: :cross do |f| %>
  <%= f.hidden_field :parent, value: @cross.id if owner %>
  <div class="<%= "layout-side" if owner %>">
    <section>
      <% if owner %>
        <p class="hint">Build the next parents chromosome by chromosome.</p>
      <% end %>
      <div class="chromosome-columns">
        <div>
          <h2>X</h2>
          <% @male_x.each do |alleles| %>
            <div class="fly">
              <div class="genotype"><%= chromosome_math(alleles) %></div>
              <% if owner %>
                <div class="fly-actions">
                  <label class="pick"><%= f.radio_button :m_X, chromosome_string(alleles), checked: @male_x.one? %><span>&#x2642; Male</span></label>
                </div>
              <% end %>
            </div>
          <% end %>
          <% @female_x.each do |alleles| %>
            <div class="fly">
              <div class="genotype"><%= chromosome_math(alleles) %></div>
              <% if owner %>
                <div class="fly-actions">
                  <label class="pick"><%= f.radio_button :f_X, chromosome_string(alleles), checked: @female_x.one? %><span>&#x2640; Female</span></label>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
        <% [ [ "II", :II, 1 ], [ "III", :III, 2 ], [ "IV", :IV, 3 ] ].each do |title, name, index| %>
          <% list = @chromosome_lists[index] %>
          <div>
            <h2><%= title %></h2>
            <% list.each do |alleles| %>
              <div class="fly">
                <div class="genotype"><%= chromosome_math(alleles) %></div>
                <% if owner %>
                  <div class="fly-actions">
                    <label class="pick"><%= f.radio_button :"m_#{name}", chromosome_string(alleles), checked: list.one? %><span>&#x2642;</span></label>
                    <label class="pick"><%= f.radio_button :"f_#{name}", chromosome_string(alleles), checked: list.one? %><span>&#x2640;</span></label>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
    <% if owner %>
      <aside class="panel sticky-panel">
        <h2>Next cross</h2>
        <label class="choice"><%= f.radio_button :male_id, "male_chr_s", checked: true %> Male from these chromosomes</label>
        <label class="choice"><%= f.radio_button :female_id, "female_chr_s", checked: true %> Female from these chromosomes</label>
        <br>
        <%= render "next_cross_fields", form: f %>
        <%= render "new_fly_fields", form: f %>
        <p style="margin: 1rem 0 0"><%= f.submit "Set up cross", class: "button-wide" %></p>
      </aside>
    <% end %>
  </div>
<% end %>
