<% content_for(:title) { "Chromosome view · drosophila.me" } %>
<h1>Show cross</h1>
<%= render "summary", cross: @cross %>
<%= render "tabs", cross: @cross, current: :chromosome %>
<div class="panel"><%= cross_math(@cross) %></div>
<% if @cross.owned_by?(Current.user) %>
  <%= form_with url: crosses_path, scope: :cross do |f| %>
    <%= f.hidden_field :parent, value: @cross.id %>
    <div class="columns">
      <div>
        <div class="field-grid">
          <div>
            <h2>Chr. X</h2>
            <% @male_x.each do |alleles| %>
              <div class="fly">
                <%= chromosome_math(alleles) %>
                <label>&#x2642; <%= f.radio_button :m_X, chromosome_string(alleles), checked: @male_x.one? %></label>
              </div>
            <% end %>
            <% @female_x.each do |alleles| %>
              <div class="fly">
                <%= chromosome_math(alleles) %>
                <label>&#x2640; <%= f.radio_button :f_X, chromosome_string(alleles), checked: @female_x.one? %></label>
              </div>
            <% end %>
          </div>
          <% [ [ "Chr. II", :II, 1 ], [ "Chr. III", :III, 2 ], [ "Chr. IV", :IV, 3 ] ].each do |title, name, index| %>
            <% list = @chromosome_lists[index] %>
            <div>
              <h2><%= title %></h2>
              <% list.each do |alleles| %>
                <div class="fly">
                  <%= chromosome_math(alleles) %>
                  <label>&#x2642; <%= f.radio_button :"m_#{name}", chromosome_string(alleles), checked: list.one? %></label>
                  <label>&#x2640; <%= f.radio_button :"f_#{name}", chromosome_string(alleles), checked: list.one? %></label>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
        <p><%= f.submit "Cross" %></p>
      </div>
      <div class="panel">
        <h2>Next cross</h2>
        <h3>Parents</h3>
        <label><%= f.radio_button :male_id, "male_chr_s", checked: true %> &#x2642; from the chromosomes picked here</label>
        <label><%= f.radio_button :female_id, "female_chr_s", checked: true %> &#x2640; from the chromosomes picked here</label>
        <%= render "new_fly_fields", form: f %>
        <%= render "next_cross_fields", form: f %>
      </div>
    </div>
  <% end %>
<% end %>
