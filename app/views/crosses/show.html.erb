<% content_for(:title) { "#{@cross.description.presence || "Cross"} · drosophila.me" } %>
<% owner = @cross.owned_by?(Current.user) %>
<%= render "header", cross: @cross %>
<%= render "parents", cross: @cross %>
<%= render "tabs", cross: @cross, current: :fly %>
<%= form_with url: crosses_path, scope: :cross do |f| %>
  <%# Pressing Enter in a field should create the cross, not stock the first fly. %>
  <%= f.submit "Cross", class: "visually-hidden", tabindex: -1, "aria-hidden": true %>
  <div class="<%= "layout-side" if owner %>">
    <section>
      <div class="section-head">
        <h2>Offspring</h2>
        <span class="muted small"><%= pluralize(@progeny.size, "viable genotype") %></span>
      </div>
      <% if owner %>
        <p class="hint">Pick a male and a female to set up the next cross.</p>
      <% end %>
      <div class="fly-list">
        <% @progeny.each do |fly| %>
          <div class="fly">
            <div class="genotype"><%= genotype_math(fly) %></div>
            <% if owner %>
              <div class="fly-actions">
                <% if fly.genotype.can_be_male? && (!@sons_recorded || Genotype.y_marker?(fly.chr1)) %>
                  <label class="pick"><%= f.radio_button :male_id, fly.id %><span>&#x2642; Male</span></label>
                <% end %>
                <% if fly.genotype.can_be_female? %>
                  <label class="pick"><%= f.radio_button :female_id, fly.id %><span>&#x2640; Female</span></label>
                <% end %>
                <button type="submit" class="button-text" formaction="<%= stock_from_fly_path(fly) %>" formmethod="post" formnovalidate>Stock it</button>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
    <% if owner %>
      <aside class="panel sticky-panel">
        <h2>Next cross</h2>
        <%= f.hidden_field :parent, value: @cross.id %>
        <%= render "next_cross_fields", form: f %>
        <%= render "new_fly_fields", form: f %>
        <p style="margin: 1rem 0 0"><%= f.submit "Set up cross", class: "button-wide" %></p>
      </aside>
    <% end %>
  </div>
<% end %>
