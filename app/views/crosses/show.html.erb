<% content_for(:title) { "Cross · drosophila.me" } %>
<h1>Show cross</h1>
<%= render "summary", cross: @cross %>
<%= render "tabs", cross: @cross, current: :fly %>
<% owner = @cross.owned_by?(Current.user) %>
<%= form_with url: crosses_path, scope: :cross do |f| %>
  <div class="<%= "columns" if owner %>">
    <div>
      <div class="panel"><%= cross_math(@cross) %></div>
      <div class="fly-list">
        <% @progeny.each do |fly| %>
          <div class="fly">
            <%= genotype_math(fly) %>
            <% if owner %>
              <label>&#x2642; <%= f.radio_button :male_id, fly.id %></label>
              <label>&#x2640; <%= f.radio_button :female_id, fly.id %></label>
            <% end %>
          </div>
        <% end %>
      </div>
      <% if owner %>
        <p><%= f.submit "Cross" %></p>
      <% end %>
    </div>
    <% if owner %>
      <div class="panel">
        <h2>Next cross</h2>
        <%= f.hidden_field :parent, value: @cross.id %>
        <%= render "new_fly_fields", form: f %>
        <%= render "next_cross_fields", form: f %>
      </div>
    <% end %>
  </div>
<% end %>
<% if owner %>
  <div class="panel">
    <h2>Keep a fly as a stock</h2>
    <div class="fly-list">
      <% @progeny.each do |fly| %>
        <div class="fly">
          <%= genotype_math(fly) %>
          <%= button_to "Stock it", stock_from_fly_path(fly), class: "button button-quiet" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
