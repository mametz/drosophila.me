<% content_for(:title) { "Your crosses · drosophila.me" } %>
<h1>Your crosses</h1>
<p><%= link_to "New cross", new_cross_path, class: "button" %></p>
<% if @crosses.empty? %>
  <p class="muted">No crosses yet.</p>
<% end %>
<% @crosses.group_by { |cross| cross.crossdate.strftime("%B %Y") }.each do |month, crosses| %>
  <h2><%= month %></h2>
  <% crosses.each do |cross| %>
    <%= link_to short_path(cross), class: "panel cross-card" do %>
      <%= "\\[#{genotype_tex(cross.male_fly.genotype.allele_sets)} \\qquad X \\qquad #{genotype_tex(cross.female_fly.genotype.allele_sets)}\\]" %>
      <p><%= cross.description %></p>
      <p class="muted"><%= cross.crossdate.strftime("Crossed on %B %d, %Y") %></p>
    <% end %>
  <% end %>
<% end %>
