<details class="more">
  <summary>Or enter a new genotype</summary>
  <label class="choice"><%= form.radio_button :male_id, "new" %> Use it as the male</label>
  <label class="choice"><%= form.radio_button :female_id, "new" %> Use it as the female</label>
  <p class="hint">A male has one X: enter it as w/- or w/Y.</p>
  <%= render "crosses/genotype_fields", form: form, fields: [
        [ :X, "X", "+/+" ], [ :II, "II", "+/+" ], [ :III, "III", "+/+" ], [ :IV, "IV", "+/+" ] ] %>
</details>
