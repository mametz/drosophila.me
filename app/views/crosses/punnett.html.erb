<% content_for(:title) { "Punnett square · drosophila.me" } %>
<h1>Show cross</h1>
<%= render "summary", cross: @cross %>
<%= render "tabs", cross: @cross, current: :punnett %>
<div class="panel"><%= cross_math(@cross) %></div>
<div class="table-wrap">
  <table class="punnett">
    <thead>
      <tr>
        <th scope="col">&#x2642; / &#x2640;</th>
        <% @square.female_chrs.each do |female| %>
          <th scope="col"><%= punnett_header(female) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @square.male_chrs.each do |male| %>
        <tr>
          <th scope="row"><%= punnett_header(male) %></th>
          <% @square.female_chrs.each do |female| %>
            <td><%= punnett_cell(male, female) %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
