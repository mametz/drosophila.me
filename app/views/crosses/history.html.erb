<% content_for(:title) { "Cross history · drosophila.me" } %>
<h1>History of cross</h1>
<% @crosses.each.with_index(1) do |cross, generation| %>
  <div class="panel">
    <div class="cross-meta">
      <h2>F<%= generation %></h2>
      <%= mail_to cross.user.email_address, title: cross.user.email_address do %>
        <%= image_tag cross.user.gravatar_url(size: 32), class: "avatar-small", alt: "" %>
      <% end %>
      <div>
        <%= link_to cross.crossdate.strftime("Crossed on %B %d, %Y"), short_path(cross) %><br>
        <%= cross.description %>
      </div>
    </div>
    <%= cross_math(cross) %>
    <div class="fly-list">
      <% cross.viable_progeny.each do |fly| %>
        <div class="fly <%= "fly-parent" if @parent_fly_ids.include?(fly.id) %>"><%= genotype_math(fly) %></div>
      <% end %>
    </div>
  </div>
<% end %>
