<% content_for(:title) { "Stock rooms · drosophila.me" } %>
<div class="page-narrow">
  <div class="page-head">
    <h1>Stock rooms</h1>
    <div class="actions">
      <%= link_to "Back to stocks", stocks_path, class: "button button-quiet" %>
      <%= link_to "New room", new_room_path, class: "button" %>
    </div>
  </div>
  <% if @rooms.empty? %>
    <div class="empty"><p>Add rooms to record where each stock is kept.</p></div>
  <% else %>
    <div class="panel table-wrap">
      <table>
        <thead><tr><th scope="col">Name</th><th scope="col">Temperature</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
          <% @rooms.each do |room| %>
            <tr>
              <td><%= room.name %></td>
              <td><%= "#{room.temperature} °C" if room.temperature %></td>
              <td>
                <div class="actions" style="justify-content: flex-end">
                  <%= link_to "Edit", edit_room_path(room), class: "button-text" %>
                  <%= button_to "Delete", room_path(room), method: :delete, class: "button-text",
                                form: { data: { turbo_confirm: "Delete this room? Its stocks are kept." } } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
