<% content_for(:title) { "Stock rooms · drosophila.me" } %>
<h1>Your stock rooms</h1>
<p><%= link_to "New stock room", new_room_path, class: "button" %></p>
<div class="panel table-wrap">
  <table>
    <thead><tr><th>Name</th><th>Temperature</th><th colspan="2"></th></tr></thead>
    <tbody>
      <% @rooms.each do |room| %>
        <tr>
          <td><%= room.name %></td>
          <td><%= room.temperature %></td>
          <td><%= link_to "Edit", edit_room_path(room) %></td>
          <td><%= button_to "Delete", room_path(room), method: :delete, class: "link-button",
                            form: { data: { turbo_confirm: "Delete this room?" } } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<p><%= link_to "Back to stocks", stocks_path %></p>
