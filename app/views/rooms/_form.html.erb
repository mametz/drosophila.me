<%= form_with model: room do |f| %>
  <% room.errors.full_messages.each do |message| %>
    <p class="flash flash-alert" role="alert"><%= message %></p>
  <% end %>
  <div class="panel">
    <div class="field-grid">
      <label>Name<%= f.text_field :name %></label>
      <label>Temperature<%= f.number_field :temperature %></label>
    </div>
    <p><%= f.submit %></p>
  </div>
<% end %>
