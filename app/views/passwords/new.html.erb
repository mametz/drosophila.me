<% content_for(:title) { "Forgot password · drosophila.me" } %>
<div class="auth">
  <h1>Forgot your password?</h1>
  <%= form_with url: passwords_path do |form| %>
    <div class="panel">
      <p class="hint">Enter your email address and we'll send you a link to set a new one.</p>
      <label>Email<%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %></label>
      <%= form.submit "Email reset instructions", class: "button-wide" %>
    </div>
  <% end %>
  <p class="auth-links"><%= link_to "Back to log in", new_session_path %></p>
</div>
