<% content_for(:title) { "New password · drosophila.me" } %>
<div class="auth">
  <h1>Choose a new password</h1>
  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="panel">
      <label>New password, at least 8 characters<%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72 %></label>
      <label>Repeat new password<%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %></label>
      <%= form.submit "Save new password", class: "button-wide" %>
    </div>
  <% end %>
</div>
