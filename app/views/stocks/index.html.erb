<% content_for(:title) { "Your stocks · drosophila.me" } %>
<h1>Your stocks</h1>
<p class="cross-actions">
  <%= link_to "New stock", new_stock_path, class: "button" %>
  <%= link_to "Stock rooms", rooms_path, class: "button button-quiet" %>
  <%= link_to "Download stocks", stocks_path(format: :csv), class: "button button-quiet", data: { turbo: false } %>
</p>
<%= form_with url: crosses_path, scope: :cross do |f| %>
  <%= f.hidden_field :parent, value: "stock" %>
  <div class="columns">
    <div class="panel table-wrap">
      <table>
        <thead>
          <tr><th>Room</th><th>Number</th><th>Genotype</th><th>Cross</th></tr>
        </thead>
        <tbody>
          <% @stocks.each do |stock| %>
            <tr>
              <td><%= stock.room&.name %></td>
              <td><%= link_to stock.number.to_s, stock_path(stock) %></td>
              <td><%= link_to genotype_math(stock.fly), stock_path(stock), class: "cross-card" %></td>
              <td>
                <label>&#x2642; <%= f.radio_button :male_id, stock.fly_id %></label>
                <label>&#x2640; <%= f.radio_button :female_id, stock.fly_id %></label>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="panel">
      <h2>Cross two stocks</h2>
      <%= render "crosses/next_cross_fields", form: f %>
      <p><%= f.submit "Cross" %></p>
    </div>
  </div>
<% end %>
