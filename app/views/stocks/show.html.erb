<% content_for(:title) { "Stock · drosophila.me" } %>
<h1>Stock <%= @stock.number %></h1>
<div class="panel">
  <p><strong>Genotype:</strong> <%= @stock.fly.chromosomes.join(" ; ") %></p>
  <%= genotype_math(@stock.fly) %>
  <p><strong>Stock room:</strong> <%= @stock.room&.name %></p>
  <p><strong>Comment:</strong> <%= @stock.comment %></p>
  <p><strong>Date established:</strong> <%= @stock.date_established&.strftime("%B %d, %Y") %></p>
  <p><strong>Reference:</strong> <%= @stock.reference %></p>
  <p><strong>Received from:</strong> <%= @stock.received_from %></p>
  <div class="cross-actions">
    <%= link_to "Edit", edit_stock_path(@stock), class: "button button-quiet" %>
    <%= button_to "Delete stock", stock_path(@stock), method: :delete, class: "button button-danger",
                  form: { data: { turbo_confirm: "Delete this stock?" } } %>
  </div>
</div>
<p><%= link_to "Back to stocks", stocks_path %></p>
