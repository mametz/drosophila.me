<% content_for(:title) { "Edit stock · drosophila.me" } %>
<h1>Edit stock</h1>
<%= render "errors", stock: @stock %>
<%= form_with model: @stock do |f| %>
  <div class="panel">
    <%= render "fields", form: f %>
    <p><%= f.submit "Update stock" %></p>
  </div>
<% end %>
<p><%= link_to "Back to stock", stock_path(@stock) %></p>
